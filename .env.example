# Browser EmailJS delivery for demo and contact forms.
NEXT_PUBLIC_EMAILJS_SERVICE_ID=service_xxxxxxx
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=template_xxxxxxx
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=your_public_key

# Optional backup copy of every lead (e.g. a Google Apps Script web app that appends rows to a Google Sheet).
# Leave empty to send leads by email only.
NEXT_PUBLIC_LEAD_WEBHOOK_URL=

# Private traffic dashboard at /admin/traffic (server-only, never NEXT_PUBLIC_).
# Without ADMIN_DASHBOARD_PASSWORD the /admin area returns 404.
ADMIN_DASHBOARD_USER=admin
ADMIN_DASHBOARD_PASSWORD=choose-a-long-random-password
# Google service account (from its JSON key file). Keep the \n sequences in the key.
GOOGLE_SERVICE_ACCOUNT_EMAIL=dashboard@your-project.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Numeric GA4 property ID (Admin -> Property details), not the G- measurement ID.
GA4_PROPERTY_ID=123456789
# Search Console property: sc-domain:medicoreerp.com or https://medicoreerp.com/
GSC_SITE_URL=sc-domain:medicoreerp.com
